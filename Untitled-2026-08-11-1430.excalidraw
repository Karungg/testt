    {
      "id": "56XgUfaoLF5BcGpTWrot5",
      "type": "text",
      "x": 2333.75,
      "y": -751.25,
      "width": 985.8956298828125,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCrV",
      "roundness": null,
      "seed": 1494922432,
      "version": 458,
      "versionNonce": 143841088,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786505576619,
      "link": null,
      "locked": false,
      "text": "E-Training isi nya bisa bikin materi jika ada atau get \ndari LMS. Terus bisa ngerjain test atau quiz disana. \nBisa juga fungsinya hanya bikin event kemudian absen \ndisana dan baca/ikut materi kemudian ngerjain test nya \ndi redirect ke LMS.\n\nOrganize Event, materi dan Quiz tetap pake akun \ndepartement.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "E-Training isi nya bisa bikin materi jika ada atau get \ndari LMS. Terus bisa ngerjain test atau quiz disana. \nBisa juga fungsinya hanya bikin event kemudian absen \ndisana dan baca/ikut materi kemudian ngerjain test nya \ndi redirect ke LMS.\n\nOrganize Event, materi dan Quiz tetap pake akun \ndepartement.",
      "autoResize": true,
      "lineHeight": 1.25
    },
