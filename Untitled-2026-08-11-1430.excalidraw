    {
      "id": "25vWvI3wxmFh3mQ_edqi4",
      "type": "text",
      "x": 1326.8333333333312,
      "y": 497.33333333333235,
      "width": 731.955810546875,
      "height": 990,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
